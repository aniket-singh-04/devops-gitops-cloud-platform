# Application Port
PORT=4444

# Environment
NODE_ENV=production

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/devops_prod?retryWrites=true&w=majority

# Custom Application Environment Variables (Add any new variables here)
# Example:
# API_SECRET_KEY=your-custom-secret-key-here
# LOG_LEVEL=info
