# ──────────────────────────────────────────────────────────────
# Ansible Inventory — Example
# Copy to hosts.ini and replace IPs with Terraform output values
# Run: terraform output -json | jq to get the IPs
# ──────────────────────────────────────────────────────────────

[k3s_master]
master ansible_host=MASTER_PUBLIC_IP

[k3s_workers]
worker1 ansible_host=WORKER_PUBLIC_IP

[k3s_cluster:children]
k3s_master
k3s_workers

[k3s_cluster:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/your-key-pair-name.pem
