# Jenkins Docker Container Configuration
JENKINS_IMAGE=jenkins-img:lst
JENKINS_SECRET=your-jenkins-agent-secret-here

# Automated Admin Credentials (created on first boot)
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin123

# Automated DockerHub Credentials (creates 'dockerhub-credentials' automatically)
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_PASSWORD=your-dockerhub-password-or-token

# SonarQube Integration
SONARQUBE_URL=http://sonarqube:9000
SONAR_TOKEN=sqa_devops_token_here
