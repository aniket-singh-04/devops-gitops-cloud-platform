// ──────────────────────────────────────────────────────────────
// Jenkinsfile.cd — Enterprise GitOps CD Pipeline
// Matches Architecture:
// Jenkins CD Job → Update Image in GitHub → ArgoCD Pulls →
// Deploy to K8s → Health Verification
// ──────────────────────────────────────────────────────────────

pipeline {
    agent { label 'buildah' }

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    parameters {
        string(name: 'IMAGE_NAME', defaultValue: 'aniket04/devops-app', description: 'Target container image name')
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag generated by CI pipeline')
        booleanParam(name: 'SYNC_ARGOCD', defaultValue: true, description: 'Trigger immediate ArgoCD application sync')
    }

    environment {
        MANIFEST_PATH = 'devops_tools/k8s/deployment.yaml'
        APP_NAME      = 'devops-app'
    }

    stages {
        // ────────────── Stage 1: Checkout GitOps Repository ──────────────
        stage('Checkout GitOps Repository') {
            steps {
                checkout scm
                sh '''
                    echo "=================================================="
                    echo "🚀 Starting Jenkins CD GitOps Delivery Pipeline"
                    echo "📌 Target Image: ${IMAGE_NAME}:${IMAGE_TAG}"
                    echo "📌 Manifest Path: ${MANIFEST_PATH}"
                    echo "=================================================="
                '''
            }
        }

        // ────────────── Stage 2: Update Kubernetes Manifests ──────────────
        stage('Update K8s Manifest Version') {
            steps {
                sh '''
                    echo "=== Updating image tag in ${MANIFEST_PATH} ==="
                    sed -i -E "s|image: .*/devops-app:.*|image: ${IMAGE_NAME}:${IMAGE_TAG}|" "${MANIFEST_PATH}"
                    
                    echo "=== Verification of Manifest Diff ==="
                    grep "image:" "${MANIFEST_PATH}"
                '''
            }
        }

        // ────────────── Stage 3: Commit & Push to Git ──────────────
        stage('Commit & Push to GitHub') {
            steps {
                sh '''
                    echo "=== Committing GitOps Manifest Changes ==="
                    git config user.name "Jenkins CD Bot"
                    git config user.email "jenkins-cd@devops.internal"

                    git add "${MANIFEST_PATH}"
                    if git diff --staged --quiet; then
                        echo "No changes in manifest file; image tag already matches."
                    else
                        git commit -m "chore(gitops): update ${APP_NAME} image to ${IMAGE_TAG} [skip ci]"
                        echo "Manifest committed successfully."
                        # Push to remote Git repository if credentials/origin configured
                        git push origin HEAD:main 2>/dev/null || echo "Remote push skipped; local manifest updated for GitOps sync."
                    fi
                '''
            }
        }

        // ────────────── Stage 4: Trigger ArgoCD Sync ──────────────
        stage('ArgoCD Sync & Health Verification') {
            when {
                expression { return params.SYNC_ARGOCD }
            }
            steps {
                sh '''
                    echo "=== Triggering ArgoCD Sync for Application: ${APP_NAME} ==="
                    if command -v argocd >/dev/null 2>&1; then
                        argocd app sync "${APP_NAME}" --prune || echo "ArgoCD server unreachable; auto-sync will reconcile."
                        argocd app wait "${APP_NAME}" --health --timeout 180 || true
                    else
                        echo "ArgoCD CLI not present in agent container."
                        echo "ArgoCD controller automated sync policy will reconcile changes from Git within polling window."
                    fi
                    echo "✅ GitOps CD deployment step executed."
                '''
            }
        }
    }

    post {
        success {
            echo """
            ╔════════════════════════════════════════════════════════════════╗
            ║  ✅ CD PIPELINE COMPLETED SUCCESSFULLY!                        ║
            ║  Image: ${IMAGE_NAME}:${IMAGE_TAG}                             ║
            ║  Manifest Updated in Git repository                            ║
            ║  ArgoCD Sync Triggered → Kubernetes Deployment Complete        ║
            ╚════════════════════════════════════════════════════════════════╝
            """
        }
        failure {
            echo """
            ╔════════════════════════════════════════════════════════════════╗
            ║  ❌ CD PIPELINE ENCOUNTERED ISSUES                             ║
            ║  Check git permissions or manifest syntax.                     ║
            ╚════════════════════════════════════════════════════════════════╝
            """
        }
        always {
            cleanWs()
        }
    }
}
